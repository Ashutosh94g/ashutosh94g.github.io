---
/**
 * Skills — three quiet columns, mono labels, staggered reveal.
 *
 * Source: Resume\resume.tex Technical Skills section.
 * Style: typographic, no icon-soup, no logos. Hover on each chip lights
 * up a subtle accent.
 */

const groups = [
  {
    label: "Backend & platform",
    items: [
      "C",
      "C++",
      "Python",
      "Rust",
      "SQL",
      "gRPC",
      "Protobuf",
      "Oracle DB",
      "Linux/UNIX",
    ],
  },
  {
    label: "Distributed systems",
    items: [
      "HAProxy",
      "HashiCorp Consul",
      "HashiCorp Nomad",
      "Consul Template",
      "Apache Kafka",
      "Service discovery",
      "Load balancing",
      "High availability",
    ],
  },
  {
    label: "Developer leverage",
    items: [
      "Lex/Yacc",
      "Git",
      "Linux Shell",
      "Vim",
      "VS Code",
      "Tmux",
      "Cursor",
      "AI agent workflows",
      "Knowledge engineering",
      "Context design",
      "Data structures & algorithms",
      "System design",
    ],
  },
];
---

<section
  id="skills"
  class="relative scroll-mt-20 py-28 sm:py-36 border-b border-[var(--border)]"
  aria-labelledby="skills-heading"
>
  <div class="site-container">
    <header class="reveal mb-14 max-w-3xl">
      <p class="eyebrow mb-3">04 / Stack</p>
      <h2 id="skills-heading" class="display-2">
        Skills grouped by the problems I solve.
      </h2>
    </header>

    <div class="grid md:grid-cols-3 gap-10 lg:gap-16">
      {groups.map((g, i) => (
        <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-[var(--fg-faint)]">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="flex-1 h-px bg-[var(--border)]"></div>
          </div>
          <h3 class="font-serif text-xl font-semibold mb-5">{g.label}</h3>
          <ul class="list-none m-0 p-0 flex flex-wrap gap-2">
            {g.items.map((item) => (
              <li>
                <span class="tech-chip">
                  <span class="tech-dot" aria-hidden="true"></span>
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Marquee strip — quiet kinetic line -->
    <div class="reveal mt-20 marquee py-4 border-y border-[var(--border)]">
      <div class="marquee-track">
        {Array.from({ length: 2 }).map(() => (
          <Fragment>
            {[
              "Distributed systems",
              "Compilers",
              "Knowledge engineering",
              "Platform infrastructure",
              "AI agent workflows",
              "Telecom backend",
              "Service discovery",
              "Parser-driven tooling",
            ].map((label) => (
              <span class="font-mono text-xs uppercase tracking-[0.32em] text-[var(--fg-faint)] whitespace-nowrap inline-flex items-center gap-3">
                {label}
                <span aria-hidden="true" class="text-[var(--color-accent-400)]">&#9670;</span>
              </span>
            ))}
          </Fragment>
        ))}
      </div>
    </div>
  </div>
</section>
