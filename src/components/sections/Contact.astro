---
/**
 * Contact — large serif call to action with magnetic links.
 * No form. Static.
 */

const channels = [
  {
    label: "Email",
    value: "ashutosh94g@gmail.com",
    href: "mailto:ashutosh94g@gmail.com",
    icon: "mail",
  },
  {
    label: "Website",
    value: "ashutoshmodi.in",
    href: "https://ashutoshmodi.in/",
    icon: "site",
    external: true,
  },
  {
    label: "LinkedIn",
    value: "in/ashutosh94g",
    href: "https://www.linkedin.com/in/ashutosh94g/",
    icon: "linkedin",
    external: true,
  },
  {
    label: "GitHub",
    value: "github.com/ashutosh94g",
    href: "https://github.com/ashutosh94g",
    icon: "github",
    external: true,
  },
  {
    label: "Resume",
    value: "resume.pdf",
    href: "/resume.pdf",
    icon: "doc",
    external: true,
  },
];
---

<section
  id="contact"
  class="relative scroll-mt-20 py-32 sm:py-40 overflow-hidden"
  aria-labelledby="contact-heading"
>
  <!-- Aurora floor -->
  <div
    class="absolute inset-0 pointer-events-none opacity-50"
    style="background:
      radial-gradient(700px 380px at 18% 100%, rgba(139, 92, 246, 0.22), transparent 65%),
      radial-gradient(560px 320px at 82% 100%, rgba(236, 72, 153, 0.16), transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative site-container">
    <div class="max-w-4xl">
      <p class="reveal eyebrow mb-5">06 / Contact</p>
      <h2
        id="contact-heading"
        class="reveal reveal-delay-1 display-1 mb-8 leading-[1.02]"
      >
        Let&rsquo;s build systems <span class="gradient-text">that last.</span>
      </h2>
      <p class="reveal reveal-delay-2 text-xl text-[var(--fg-muted)] leading-relaxed max-w-2xl">
        Open to backend, platform, and developer-productivity roles at teams that care about reliability and engineering leverage &mdash; <strong class="text-[var(--fg)]">India, EU, or remote</strong>. Best reached over email; LinkedIn works too.
      </p>
    </div>

    <ul class="reveal reveal-delay-3 grid gap-3 sm:grid-cols-2 mt-14 list-none m-0 p-0">
      {channels.map((c) => (
        <li>
          <a
            href={c.href}
            {...(c.external ? { target: "_blank", rel: "noopener" } : {})}
            class="magnetic group relative flex items-center gap-5 p-5 sm:p-6 rounded-2xl border border-[var(--border)] bg-[rgba(255,255,255,0.015)] no-underline overflow-hidden hover:border-[var(--border-strong)] transition-all duration-300"
          >
            <!-- Hover wash -->
            <span
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style="background: linear-gradient(120deg, rgba(99,102,241,0.08), rgba(236,72,153,0.06));"
              aria-hidden="true"
            ></span>

            <span
              class="relative shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-xl border border-[var(--border-strong)] bg-[var(--bg-elev)] text-[var(--fg-muted)] group-hover:text-[var(--fg)] group-hover:border-[var(--color-accent-400)] transition-all duration-300"
              aria-hidden="true"
            >
              {c.icon === "mail" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
              {c.icon === "linkedin" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.21 0 22.23 0z" />
                </svg>
              )}
              {c.icon === "github" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.97c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.86 10.86 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.36.78 1.05.78 2.13v3.16c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
                </svg>
              )}
              {c.icon === "doc" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                  <path d="M9 13h6" />
                  <path d="M9 17h6" />
                </svg>
              )}
              {c.icon === "site" && (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20" />
                  <path d="M12 2a15.3 15.3 0 0 1 0 20" />
                  <path d="M12 2a15.3 15.3 0 0 0 0 20" />
                </svg>
              )}
            </span>

            <span class="relative flex-1 min-w-0">
              <span class="block text-xs font-mono uppercase tracking-[0.2em] text-[var(--fg-faint)] mb-1">
                {c.label}
              </span>
              <span class="block text-base sm:text-lg text-[var(--fg)] truncate">
                {c.value}
              </span>
            </span>

            <span
              class="relative shrink-0 text-[var(--fg-faint)] group-hover:text-[var(--fg)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300"
              aria-hidden="true"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
