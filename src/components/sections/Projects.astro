---
/**
 * Projects — bento layout: one wide hero tile + 3 normal tiles.
 *
 * Each tile links to its MDX case study where one exists. Status, dates,
 * and tech chips come straight from the resume.
 */
import ProjectTile from "../ProjectTile.astro";

const projects = [
  {
    index: "01",
    title: "Tuxedo \u2192 gRPC Migration Framework",
    status: "In rollout",
    dates: "Jun 2025 \u2192 Nov 2025",
    href: "/case-studies/tuxedo-grpc/",
    summary:
      "A migration framework that wraps legacy Tuxedo-style services with typed gRPC interfaces while preserving existing business logic. The interesting part is the safety model: generated contracts, runtime routing, and a rollout path that lets old and new systems coexist.",
    bullets: [
      "Validated end-to-end as a POC on a production service.",
      "Built for incremental rollout across long-lived telecom systems.",
      "Shows my approach to modernization without rewriting working code.",
    ],
    tech: ["gRPC", "Protobuf", "HAProxy", "Consul", "Nomad", "Kafka"],
    accent: "violet" as const,
    pattern: "circuit" as const,
    span: "wide" as const,
  },
  {
    index: "02",
    title: "AI Knowledge Layer for Legacy Code",
    status: "Live & expanding",
    dates: "Aug 2025 \u2192 present",
    href: "/case-studies/atlas-knowledge-engine/",
    summary:
      "Cursor workflows, team knowledge bases, and layered context design for large legacy codebases. The goal is not to make AI sound confident; it is to make it load the right source-backed context before it helps an engineer.",
    tech: ["Cursor", "Agent workflows", "Knowledge engineering"],
    accent: "indigo" as const,
    pattern: "mesh" as const,
  },
  {
    index: "03",
    title: "XFocus",
    status: "Replacing licensed software",
    dates: "Jul 2024 \u2192 Oct 2024",
    href: "/case-studies/compiler-driven-quality/",
    summary:
      "A Python reporting library on Pandas/NumPy, plus a Lex/Yacc converter that moves legacy WebFOCUS scripts into the new surface. This is the same pattern I like elsewhere: parse the old language, generate the safe migration path.",
    tech: ["Python", "Pandas", "NumPy", "Lex/Yacc"],
    accent: "magenta" as const,
    pattern: "lines" as const,
  },
  {
    index: "04",
    title: "C/C++ Prototype Generator",
    status: "Production",
    dates: "Jun 2023 \u2192 Sep 2023",
    href: "/case-studies/compiler-driven-quality/",
    summary:
      "A build-time compiler that scans C sources, generates function prototypes, and catches signature drift before it becomes a production defect. Small tool, large leverage.",
    tech: ["Lex/Yacc", "C/C++", "Shell"],
    accent: "cyan" as const,
    pattern: "circuit" as const,
  },
];
---

<section
  id="projects"
  class="relative scroll-mt-20 py-28 sm:py-36 border-b border-[var(--border)] overflow-hidden"
  aria-labelledby="projects-heading"
>
  <!-- Soft underpaint -->
  <div
    class="absolute top-1/3 -left-32 w-[600px] h-[600px] rounded-full opacity-15 blur-3xl pointer-events-none"
    style="background: radial-gradient(circle, #ec4899 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative site-container">
    <header class="reveal mb-16 max-w-3xl">
      <p class="eyebrow mb-3">03 / Selected work</p>
      <h2 id="projects-heading" class="display-2 mb-4">
        Selected engineering stories, not product pitches.
      </h2>
      <p class="text-lg text-[var(--fg-muted)] leading-relaxed">
        These are the projects I would talk through with another engineer:
        what was fragile, what I changed, how I reduced risk, and what the work
        taught me about building in large systems.
      </p>
    </header>

    <div class="grid md:grid-cols-3 gap-5 sm:gap-6">
      {projects.map((p, i) => (
        <div class={`reveal ${p.span === "wide" ? "md:col-span-3" : ""}`} style={`transition-delay: ${i * 80}ms`}>
          <ProjectTile
            index={p.index}
            title={p.title}
            status={p.status}
            dates={p.dates}
            href={p.href}
            summary={p.summary}
            bullets={p.bullets}
            tech={p.tech}
            accent={p.accent}
            pattern={p.pattern}
            span={p.span}
          />
        </div>
      ))}
    </div>
  </div>
</section>
