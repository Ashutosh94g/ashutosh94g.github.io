---
/**
 * Categorised technology stack used across my work, rendered as a wall of
 * coloured chips. Recruiters skim for keywords; engineers skim for
 * specificity. The chips are grouped so both audiences find what they want
 * within ten seconds.
 *
 * Each group has a coloured icon-tile so the wall reads as four distinct
 * "skill pillars" rather than one soup of chips.
 */

interface Tech {
  name: string;
  color?: string;
}

interface Group {
  title: string;
  blurb: string;
  accent: { from: string; to: string };
  iconPaths: string[]; // SVG <path d=…> values
  items: Tech[];
}

const groups: Group[] = [
  {
    title: 'Distributed systems',
    blurb: 'gRPC services, service discovery, message buses, legacy migration.',
    accent: { from: '#6366f1', to: '#8b5cf6' },
    iconPaths: [
      'M3 12h4 M17 12h4 M12 3v4 M12 17v4',
      'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
      'M5.6 5.6l2.8 2.8 M15.6 15.6l2.8 2.8 M5.6 18.4l2.8-2.8 M15.6 8.4l2.8-2.8',
    ],
    items: [
      { name: 'gRPC', color: '#244c5a' },
      { name: 'Protocol Buffers', color: '#4285f4' },
      { name: 'HAProxy', color: '#7d4ad9' },
      { name: 'HashiCorp Consul', color: '#e03875' },
      { name: 'HashiCorp Nomad', color: '#00ca8e' },
      { name: 'Apache Kafka', color: '#231f20' },
      { name: 'Oracle Tuxedo', color: '#ea1b22' },
    ],
  },
  {
    title: 'AI & knowledge engineering',
    blurb:
      'Atlas (in-house engine), reasoning atoms, LLM-driven workflows, layered context.',
    accent: { from: '#ec4899', to: '#a855f7' },
    iconPaths: [
      'M12 2v4 M12 18v4 M2 12h4 M18 12h4 M5 5l3 3 M16 16l3 3 M5 19l3-3 M16 8l3-3',
      'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
    ],
    items: [
      { name: 'Atlas (in-house)', color: '#6366f1' },
      { name: 'Cursor', color: '#1e1e1e' },
      { name: 'Claude / Sonnet', color: '#cc785c' },
      { name: 'GPT-4 class', color: '#10a37f' },
      { name: 'Reasoning atoms', color: '#a855f7' },
      { name: 'Layered context', color: '#0ea5e9' },
    ],
  },
  {
    title: 'Compilers & languages',
    blurb:
      'Lex/Yacc grammars, transpilers, Java/Spring, Python data pipelines, low-level C/C++.',
    accent: { from: '#f59e0b', to: '#f97316' },
    iconPaths: [
      'M16 18l6-6-6-6 M8 6l-6 6 6 6',
      'M14 4l-4 16',
    ],
    items: [
      { name: 'Lex / Flex', color: '#f59e0b' },
      { name: 'Yacc / Bison', color: '#f59e0b' },
      { name: 'C', color: '#283593' },
      { name: 'C++', color: '#00599c' },
      { name: 'Java', color: '#ed8b00' },
      { name: 'Spring Boot', color: '#6db33f' },
      { name: 'Python', color: '#3776ab' },
      { name: 'Pandas / NumPy', color: '#150458' },
      { name: 'Pro*C', color: '#dc2626' },
    ],
  },
  {
    title: 'Infrastructure',
    blurb: 'Linux platforms, container builds, Oracle DB, source control & CI.',
    accent: { from: '#10b981', to: '#14b8a6' },
    iconPaths: [
      'M2 7l10-4 10 4-10 4-10-4Z',
      'M2 12l10 4 10-4',
      'M2 17l10 4 10-4',
    ],
    items: [
      { name: 'Linux', color: '#000000' },
      { name: 'Docker', color: '#2496ed' },
      { name: 'Maven', color: '#c71a36' },
      { name: 'CMake', color: '#064f8c' },
      { name: 'Git / GitHub', color: '#181717' },
      { name: 'Oracle DB', color: '#f80000' },
      { name: 'TIBCO WebFOCUS', color: '#0a3061' },
    ],
  },
];
---

<section
  id="stack"
  class="relative max-w-5xl mx-auto px-5 sm:px-8 py-20 border-t border-[var(--border)]"
  aria-labelledby="stack-heading"
>
  <header class="max-w-3xl mb-12">
    <p
      class="text-xs uppercase tracking-[0.2em] font-medium text-[var(--color-accent-600)] dark:text-[var(--color-accent-400)] mb-3"
    >
      Tools of the trade
    </p>
    <h2 id="stack-heading" class="display-2 mb-3">
      The stack I&rsquo;ve shipped real systems on.
    </h2>
    <p class="text-lg text-[var(--fg-muted)] leading-relaxed max-w-2xl">
      Not a wishlist &mdash; this is what runs in production today, what I
      reach for first, and what I can drop into on day one. Click through the
      case studies to see how each one is actually used.
    </p>
  </header>

  <div class="grid gap-5 md:grid-cols-2">
    {
      groups.map((group) => (
        <article
          class="group relative rounded-2xl border border-[var(--border)] bg-[var(--bg-elev)] p-6 sm:p-7 overflow-hidden transition-all hover:-translate-y-1 hover:border-[var(--border-strong)]"
          style={`--from:${group.accent.from}; --to:${group.accent.to}; --shadow-on-hover: 0 22px 50px -22px color-mix(in oklab, ${group.accent.from} 50%, transparent), 0 8px 20px -10px color-mix(in oklab, ${group.accent.from} 30%, transparent);`}
        >
          <span
            class="absolute top-0 left-0 right-0 h-[3px]"
            style={`background: linear-gradient(90deg, ${group.accent.from}, ${group.accent.to});`}
            aria-hidden="true"
          />
          <span
            class="absolute -top-16 -right-16 w-44 h-44 rounded-full opacity-20 blur-3xl pointer-events-none"
            style={`background: radial-gradient(circle, ${group.accent.from}, transparent 70%);`}
            aria-hidden="true"
          />

          <div class="relative flex items-start gap-4 mb-5">
            <div
              class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center text-white"
              style={`background: linear-gradient(135deg, ${group.accent.from}, ${group.accent.to}); box-shadow: 0 10px 24px -10px color-mix(in oklab, ${group.accent.from} 60%, transparent);`}
              aria-hidden="true"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {group.iconPaths.map((d) => (
                  <path d={d} />
                ))}
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold tracking-tight leading-tight mb-1">
                {group.title}
              </h3>
              <p class="text-sm text-[var(--fg-muted)] leading-relaxed m-0">
                {group.blurb}
              </p>
            </div>
          </div>

          <div class="relative flex flex-wrap gap-2">
            {group.items.map((t) => (
              <span class="tech-chip" style={`--chip-color: ${t.color}`}>
                <span class="tech-dot" aria-hidden="true" />
                {t.name}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  article:hover {
    box-shadow: var(--shadow-on-hover);
  }
</style>
