---
import Counter from './Counter.astro';

interface Stat {
  value: string;
  prefix?: string;
  suffix?: string;
  label: string;
  caption?: string;
  accentFrom?: string;
  accentTo?: string;
}

interface Props {
  stats: Stat[];
  cols?: 2 | 3 | 4;
  variant?: 'inline' | 'cards';
  size?: 'md' | 'lg' | 'xl';
}

const { stats, cols = 4, variant = 'inline', size = 'md' } = Astro.props;

const colsClass = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 sm:grid-cols-3',
  4: 'grid-cols-2 sm:grid-cols-4',
}[cols];

// Auto-rotate accent colors when each stat doesn't supply its own.
const palette = [
  { from: '#6366f1', to: '#8b5cf6' }, // indigo  -> violet
  { from: '#f59e0b', to: '#f97316' }, // amber   -> orange
  { from: '#ec4899', to: '#a855f7' }, // pink    -> purple
  { from: '#10b981', to: '#14b8a6' }, // emerald -> teal
];
---

<div class={`grid ${colsClass} gap-x-6 gap-y-8 sm:gap-y-10`}>
  {
    stats.map((s, i) => {
      const accent = palette[i % palette.length];
      const from = s.accentFrom ?? accent.from;
      const to = s.accentTo ?? accent.to;
      return (
        <div
          class={
            variant === 'cards'
              ? 'rounded-xl border border-[var(--border)] bg-[var(--bg-elev)] p-5 shadow-[var(--shadow-card)]'
              : 'border-l-2 pl-4'
          }
          style={
            variant === 'inline'
              ? `border-color: color-mix(in oklab, ${from} 50%, transparent);`
              : undefined
          }
        >
          <Counter
            value={s.value}
            prefix={s.prefix}
            suffix={s.suffix}
            label={s.label}
            caption={s.caption}
            align="left"
            size={size}
            accentFrom={from}
            accentTo={to}
          />
        </div>
      );
    })
  }
</div>
