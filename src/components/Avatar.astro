---
/**
 * Headshot avatar with an animated gradient ring.
 *
 * Uses /avatar.jpg if the user drops a photo into public/. If the photo is
 * missing, falls back to a serif "AM" mark on a deep ink background with the
 * same gradient ring -- so the page still looks intentional and never shows
 * a broken-image icon.
 *
 * Both states get the same outer ring: a slowly-rotating conic gradient that
 * gives the whole hero a tiny bit of life without being distracting.
 */
interface Props {
  size?: number;
  initials?: string;
  src?: string;
  alt?: string;
  caption?: string;
}

const {
  size = 220,
  initials = 'am',
  src = '/avatar.jpg',
  alt = 'Ashutosh Modi',
  caption,
} = Astro.props;
---

<figure
  class="avatar-figure"
  style={`--avatar-size: ${size}px;`}
>
  <span class="avatar-ring" aria-hidden="true"></span>
  <span class="avatar-disc">
    <img
      src={src}
      alt={alt}
      class="avatar-img"
      loading="eager"
      decoding="async"
      width={size}
      height={size}
      onerror="this.style.display='none'; this.parentElement.classList.add('avatar-fallback');"
    />
    <span class="avatar-initials" aria-hidden="true">{initials}</span>
  </span>
  {caption && <figcaption class="avatar-caption">{caption}</figcaption>}
</figure>

<style>
  .avatar-figure {
    position: relative;
    width: var(--avatar-size);
    height: var(--avatar-size);
    margin: 0;
    isolation: isolate;
  }

  .avatar-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: conic-gradient(
      from 90deg,
      #4f46e5 0deg,
      #8b5cf6 90deg,
      #ec4899 180deg,
      #06b6d4 270deg,
      #4f46e5 360deg
    );
    filter: blur(0.5px);
    z-index: 0;
    animation: avatar-spin 14s linear infinite;
  }

  .avatar-ring::after {
    content: "";
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: var(--bg);
  }

  .avatar-disc {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 28%, color-mix(in oklab, var(--color-accent-500) 30%, transparent), transparent 65%),
      var(--color-ink-900);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-accent-500) 35%, transparent),
      0 24px 48px -20px rgba(15, 23, 42, 0.45);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: calc(var(--avatar-size) * 0.42);
    color: #fff;
    letter-spacing: -0.04em;
    pointer-events: none;
  }

  /* Hide the initials by default; if the image fails to load, the inline
     onerror handler adds .avatar-fallback to .avatar-disc to reveal them. */
  .avatar-disc:not(.avatar-fallback) .avatar-initials {
    opacity: 0;
  }

  .avatar-disc.avatar-fallback {
    background:
      radial-gradient(circle at 30% 28%, color-mix(in oklab, #8b5cf6 55%, transparent), transparent 60%),
      radial-gradient(circle at 75% 80%, color-mix(in oklab, #ec4899 50%, transparent), transparent 65%),
      var(--color-ink-900);
  }

  .avatar-caption {
    position: absolute;
    bottom: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--fg-subtle);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes avatar-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-ring { animation: none; }
  }
</style>
