---
/**
 * Hero — full-viewport opening.
 *
 * Stack:
 *   - Aurora background (CSS keyframes, GPU-only).
 *   - Faint dot grid layered over it.
 *   - Status pill with animated availability dot.
 *   - Split-text headline reveal (per-word stagger, CSS keyframes only).
 *   - Sub-headline + supporting copy faded in on a delay.
 *   - Two CTAs: primary (gradient + magnetic), secondary (resume).
 *   - Compact KPI strip pulled from the resume.
 *   - Scroll cue at the bottom.
 *
 * No JS bundled here — magnetic.ts in BaseLayout handles the .magnetic
 * elements globally.
 */

const headlineIntro = ["Hi,", "I\u2019m"] as const;
const headlineFirstName = "Ashutosh";
const headlineLastName = "Modi.";
const headlineLine2 = [
  "I",
  "build",
  "reliable",
  "backend",
  "platforms",
  "and",
  "developer",
  "tools.",
] as const;

const baseDelay = 200;
const wordStep = 70;
const nameStart = baseDelay + headlineIntro.length * wordStep + 60;
const line2Start = baseDelay + (headlineIntro.length + 2) * wordStep + 140;

const stats = [
  { value: "3.5y", label: "Software developer", caption: "Amdocs · Gurgaon" },
  { value: "4-5", label: "Team execution", caption: "Review + unblocking" },
  { value: "500+", label: "Legacy scripts", caption: "Automated migration work" },
  { value: "50%+", label: "Tooling friction cut", caption: "Cursor + shell workflows" },
];
---

<section
  class="hero relative overflow-hidden border-b border-[var(--border)]"
  aria-labelledby="hero-heading"
>
  <!-- Animated aurora -->
  <div class="aurora" aria-hidden="true">
    <div class="aurora-blob"></div>
  </div>

  <!-- Faint dot grid texture -->
  <div
    class="absolute inset-0 dot-grid pointer-events-none opacity-60 fade-edge-y"
    aria-hidden="true"
  ></div>

  <!-- Top corner gradient sliver -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[80vw] h-px pointer-events-none"
    style="background: linear-gradient(90deg, transparent, rgba(167,139,250,0.55), transparent);"
    aria-hidden="true"
  ></div>

  <div class="relative site-container pt-28 pb-24 sm:pt-36 sm:pb-32">
    <!-- Status pill -->
    <div
      class="hero-fade mb-8"
      style={`--delay: ${baseDelay - 100}ms`}
    >
      <span class="status-pill">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="text-[var(--fg-muted)]">
          Currently focused on <span class="text-[var(--fg)] font-semibold">backend modernization</span> and AI-assisted developer workflows
        </span>
      </span>
    </div>

    <!-- Eyebrow -->
    <p
      class="hero-fade eyebrow mb-7"
      style={`--delay: ${baseDelay - 40}ms`}
    >
      Software Developer <span class="text-[var(--fg-faint)]">/</span> Backend &amp; Platform <span class="text-[var(--fg-faint)]">/</span> Gurgaon, India
    </p>

    <!-- Display headline -->
    <h1 id="hero-heading" class="display-1 max-w-none sm:max-w-[18ch] mb-2">
      <span class="hero-line">
        {headlineIntro.map((word, i) => (
          <span style={`--delay: ${baseDelay + i * wordStep}ms`}>
            <em class="font-light text-[var(--fg-muted)]">{word}</em>
            {i < headlineIntro.length - 1 && " "}
          </span>
        ))}
      </span>
      <span class="hero-line hero-name-line">
        <span style={`--delay: ${nameStart}ms`}>{headlineFirstName}</span>
      </span>
      <span class="hero-line hero-name-line">
        <span style={`--delay: ${nameStart + wordStep}ms`}>{headlineLastName}</span>
      </span>
      <span class="hero-line gradient-text mt-1">
        {headlineLine2.map((word, i) => (
          <span style={`--delay: ${line2Start + i * wordStep}ms`}>
            {word}
            {i < headlineLine2.length - 1 && " "}
          </span>
        ))}
      </span>
    </h1>

    <!-- Sub-headline -->
    <p
      class="hero-fade text-lg sm:text-xl text-[var(--fg-muted)] leading-relaxed max-w-2xl mt-10"
      style={`--delay: ${line2Start + headlineLine2.length * wordStep + 200}ms`}
    >
      I work on the careful side of software: modernizing long-lived C/C++
      systems, building parser-driven automation, and shaping Cursor-based AI
      workflows that help engineers move faster without losing production
      judgment.
    </p>

    <!-- CTAs -->
    <div
      class="hero-fade flex flex-wrap items-center gap-3 mt-10"
      style={`--delay: ${line2Start + headlineLine2.length * wordStep + 360}ms`}
    >
      <a
        href="/resume.pdf"
        class="btn-cta btn-cta-primary magnetic-strong"
        target="_blank"
        rel="noopener"
      >
        Resume PDF
        <svg
          aria-hidden="true"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3v12" />
          <path d="m6 9 6 6 6-6" />
          <path d="M5 21h14" />
        </svg>
      </a>
      <a
        href="#principles"
        class="btn-cta btn-cta-secondary magnetic"
        data-scroll-target
      >
        <svg
          aria-hidden="true"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m13 5 7 7-7 7" />
        </svg>
        How I work
      </a>
      <a
        href="https://www.linkedin.com/in/ashutosh94g/"
        target="_blank"
        rel="noopener"
        class="btn-cta btn-cta-secondary magnetic"
        aria-label="LinkedIn"
      >
        <svg
          aria-hidden="true"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.21 0 22.23 0z"
          />
        </svg>
        LinkedIn
      </a>
      <a
        href="https://github.com/ashutosh94g"
        target="_blank"
        rel="noopener"
        class="btn-cta btn-cta-secondary magnetic"
        aria-label="GitHub"
      >
        <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.97c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.86 10.86 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.36.78 1.05.78 2.13v3.16c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
          />
        </svg>
        GitHub
      </a>
    </div>

    <!-- Quiet contact line -->
    <p
      class="hero-fade text-sm text-[var(--fg-faint)] mt-7"
      style={`--delay: ${line2Start + headlineLine2.length * wordStep + 480}ms`}
    >
      <a
        href="mailto:ashutosh94g@gmail.com"
        class="text-[var(--fg-muted)] hover:text-[var(--fg)] no-underline"
      >ashutosh94g@gmail.com</a>
      &nbsp;<span class="text-[var(--fg-faint)]">&middot;</span>&nbsp; Open to backend, platform, and developer-productivity roles &nbsp;<span class="text-[var(--fg-faint)]">&middot;</span>&nbsp; India / EU / Remote
    </p>

    <!-- KPI strip -->
    <div
      class="hero-fade mt-20 grid grid-cols-2 lg:grid-cols-4 gap-3"
      style={`--delay: ${line2Start + headlineLine2.length * wordStep + 620}ms`}
    >
      {stats.map((s) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[rgba(255,255,255,0.015)] backdrop-blur-sm px-5 py-5 transition-all hover:border-[var(--border-strong)] hover:-translate-y-0.5">
          <div class="kpi-number mb-1">{s.value}</div>
          <div class="text-sm font-medium text-[var(--fg)] mb-0.5">{s.label}</div>
          <div class="text-xs text-[var(--fg-faint)] font-mono">{s.caption}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    class="hero-fade absolute bottom-6 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-2 text-[var(--fg-faint)]"
    style={`--delay: ${line2Start + headlineLine2.length * wordStep + 800}ms`}
    aria-hidden="true"
  >
    <span class="text-[10px] font-mono uppercase tracking-[0.3em]">Scroll</span>
    <span class="scroll-cue"></span>
  </div>
</section>

<style>
  .hero {
    /* True-black canvas with the aurora layered above */
    background:
      radial-gradient(900px 500px at 100% 0%, rgba(99, 102, 241, 0.06), transparent 60%),
      var(--bg);
    min-height: clamp(720px, 92vh, 980px);
  }

  /* The serif italic at large sizes — synthetic italic from variable font */
  h1 em {
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  @media (max-width: 480px) {
    h1 {
      font-size: clamp(1.65rem, 7vw, 1.95rem);
    }

    .hero-name-line {
      white-space: nowrap;
    }
  }

  /* Scroll cue: a tiny vertical capsule with a falling dot */
  .scroll-cue {
    width: 18px;
    height: 28px;
    border: 1px solid currentColor;
    border-radius: 999px;
    position: relative;
    opacity: 0.6;
  }

  .scroll-cue::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 50%;
    width: 2px;
    height: 6px;
    border-radius: 2px;
    background: currentColor;
    transform: translateX(-50%);
    animation: scroll-cue-fall 1.8s ease-in-out infinite;
  }

  @keyframes scroll-cue-fall {
    0%   { transform: translate(-50%, 0);   opacity: 1; }
    70%  { transform: translate(-50%, 10px); opacity: 0; }
    100% { transform: translate(-50%, 10px); opacity: 0; }
  }
</style>
