---
import StatusPill from './StatusPill.astro';
import StatGrid from './StatGrid.astro';
import DotGrid from './DotGrid.astro';

const social = [
  {
    href: 'https://github.com/ashutosh94g',
    label: 'GitHub',
    external: true,
    primary: false,
  },
  {
    href: 'https://www.linkedin.com/in/ashutosh94g/',
    label: 'LinkedIn',
    external: true,
    primary: false,
  },
  {
    href: 'mailto:ashutosh94g@gmail.com',
    label: 'Email',
    external: false,
    primary: false,
  },
  { href: '/resume.pdf', label: 'Resume (PDF)', external: false, primary: true },
];

const stats = [
  { value: '18M', suffix: '+', label: 'Lines analyzed', caption: 'C / Pro*C / shell' },
  { value: '500', suffix: '+', label: 'Scripts auto-converted', caption: 'WebFOCUS \u2192 XFocus' },
  { value: '1,200', suffix: '+', label: 'Reasoning atoms', caption: 'Truth-grounded' },
  { value: '99.6', suffix: '%', label: 'Atom verification', caption: 'Atlas pass rate' },
];
---

<section
  class="relative overflow-hidden border-b border-[var(--border)]"
>
  <div class="absolute inset-0 hero-glow pointer-events-none" aria-hidden="true"></div>
  <DotGrid variant="sparse" fade="radial" />

  <div
    class="relative max-w-5xl mx-auto px-5 sm:px-8 pt-14 pb-16 sm:pt-20 sm:pb-24"
  >
    <div class="max-w-3xl">
      <div class="fade-up mb-6">
        <StatusPill>
          Currently shipping a Tuxedo&#8202;&rarr;&#8202;gRPC framework across Three UK and Three Ireland
        </StatusPill>
      </div>

      <p
        class="fade-up text-xs sm:text-sm text-[var(--fg-subtle)] uppercase tracking-[0.18em] font-medium mb-5"
      >
        Software Developer &middot; Amdocs &middot; Gurgaon, India
      </p>

      <h1
        class="fade-up font-serif text-4xl sm:text-5xl md:text-6xl lg:text-[4.25rem] font-semibold tracking-tight leading-[1.04] mb-7"
      >
        I build <span class="gradient-text">platform infrastructure</span> for
        Tier-1 telecom carriers.
      </h1>

      <p
        class="fade-up-delay-1 text-lg sm:text-xl text-[var(--fg-muted)] leading-relaxed mb-9 max-w-2xl"
      >
        A Tuxedo&#8202;&rarr;&#8202;gRPC migration framework rolling out across CK
        Hutchison's Three UK and Three Ireland. An AI knowledge engine over an
        18M-line legacy backend. Parser-driven tooling that turns runtime defects
        into compile-time errors.
      </p>

      <div class="fade-up-delay-2 flex flex-wrap gap-2.5 mb-12">
        {
          social.map((s) => (
            <a
              href={s.href}
              {...(s.external ? { target: '_blank', rel: 'noopener' } : {})}
              class={
                s.primary
                  ? 'inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[var(--color-accent-600)] text-white no-underline font-medium hover:bg-[var(--color-accent-700)] hover:-translate-y-px transition-all shadow-[0_8px_20px_-8px_rgba(79,70,229,0.6)]'
                  : 'inline-flex items-center gap-2 px-4 py-2 rounded-md border border-[var(--border-strong)] bg-[var(--bg-elev)]/60 backdrop-blur text-[var(--fg)] no-underline font-medium hover:bg-[var(--bg-elev)] hover:border-[var(--color-accent-500)]/40 transition-colors'
              }
            >
              {s.label}
              {s.external && (
                <svg
                  aria-hidden="true"
                  class="w-3.5 h-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <div class="fade-up-delay-3 max-w-3xl">
      <StatGrid stats={stats} cols={4} />
    </div>
  </div>
</section>
