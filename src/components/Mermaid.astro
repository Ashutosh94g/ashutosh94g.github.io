---
interface Props {
  code: string;
  caption?: string;
}

const { code, caption } = Astro.props;

const id = `mermaid-${Math.random().toString(36).slice(2, 10)}`;
---

<figure class="my-8 not-prose">
  <div
    class="mermaid-container relative border border-[var(--border)] rounded-xl bg-[var(--bg-elev)] p-4 sm:p-6 overflow-x-auto shadow-[var(--shadow-card)]"
    data-mermaid-id={id}
  >
    <pre class="mermaid-source hidden">{code}</pre>
    <div class="mermaid-render text-[var(--fg)] flex justify-center items-center min-h-[120px]"></div>
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-sm text-[var(--fg-subtle)] text-center max-w-3xl mx-auto leading-relaxed">
        {caption}
      </figcaption>
    )
  }
</figure>

<script>
  type MermaidTheme = {
    theme: 'base';
    themeVariables: Record<string, string>;
    fontFamily: string;
    fontSize: string;
  };

  function isDark() {
    return document.documentElement.dataset.theme === 'dark';
  }

  function buildThemeConfig(): MermaidTheme {
    const dark = isDark();
    if (dark) {
      return {
        theme: 'base',
        fontFamily:
          'Inter Variable, Inter, ui-sans-serif, system-ui, sans-serif',
        fontSize: '14px',
        themeVariables: {
          background: '#0f172a',
          mainBkg: '#1e293b',
          primaryColor: '#312e81',
          primaryTextColor: '#e0e7ff',
          primaryBorderColor: '#6366f1',
          lineColor: '#94a3b8',
          secondaryColor: '#1e293b',
          secondaryTextColor: '#cbd5e1',
          secondaryBorderColor: '#475569',
          tertiaryColor: '#0f172a',
          tertiaryTextColor: '#cbd5e1',
          tertiaryBorderColor: '#334155',
          textColor: '#e2e8f0',
          fontFamily:
            'Inter Variable, Inter, ui-sans-serif, system-ui, sans-serif',
          fontSize: '14px',
          // sequence
          actorBkg: '#1e293b',
          actorTextColor: '#e0e7ff',
          actorBorder: '#6366f1',
          actorLineColor: '#475569',
          signalColor: '#cbd5e1',
          signalTextColor: '#cbd5e1',
          labelBoxBkgColor: '#312e81',
          labelBoxBorderColor: '#6366f1',
          labelTextColor: '#e0e7ff',
          loopTextColor: '#cbd5e1',
          noteBkgColor: '#1e1b4b',
          noteTextColor: '#c7d2fe',
          noteBorderColor: '#6366f1',
          activationBkgColor: '#312e81',
          activationBorderColor: '#6366f1',
          // flowchart
          clusterBkg: '#0b1024',
          clusterBorder: '#334155',
          edgeLabelBackground: '#1e293b',
          nodeTextColor: '#e0e7ff',
        },
      };
    }
    return {
      theme: 'base',
      fontFamily:
        'Inter Variable, Inter, ui-sans-serif, system-ui, sans-serif',
      fontSize: '14px',
      themeVariables: {
        background: '#ffffff',
        mainBkg: '#eef2ff',
        primaryColor: '#eef2ff',
        primaryTextColor: '#1e1b4b',
        primaryBorderColor: '#6366f1',
        lineColor: '#475569',
        secondaryColor: '#f1f5f9',
        secondaryTextColor: '#1e293b',
        secondaryBorderColor: '#94a3b8',
        tertiaryColor: '#ffffff',
        tertiaryTextColor: '#334155',
        tertiaryBorderColor: '#cbd5e1',
        textColor: '#0f172a',
        fontFamily:
          'Inter Variable, Inter, ui-sans-serif, system-ui, sans-serif',
        fontSize: '14px',
        // sequence
        actorBkg: '#eef2ff',
        actorTextColor: '#1e1b4b',
        actorBorder: '#6366f1',
        actorLineColor: '#94a3b8',
        signalColor: '#475569',
        signalTextColor: '#1e293b',
        labelBoxBkgColor: '#e0e7ff',
        labelBoxBorderColor: '#6366f1',
        labelTextColor: '#312e81',
        loopTextColor: '#475569',
        noteBkgColor: '#fef3c7',
        noteTextColor: '#78350f',
        noteBorderColor: '#f59e0b',
        activationBkgColor: '#e0e7ff',
        activationBorderColor: '#6366f1',
        // flowchart
        clusterBkg: '#f8fafc',
        clusterBorder: '#cbd5e1',
        edgeLabelBackground: '#ffffff',
        nodeTextColor: '#1e293b',
      },
    };
  }

  let renderToken = 0;

  async function renderAll() {
    const containers = document.querySelectorAll<HTMLElement>('.mermaid-container');
    if (!containers.length) return;

    const myToken = ++renderToken;

    let mermaid;
    try {
      ({ default: mermaid } = await import('mermaid'));
    } catch (err) {
      console.error('Mermaid module failed to load', err);
      for (const container of Array.from(containers)) {
        const renderEl = container.querySelector<HTMLElement>('.mermaid-render');
        if (renderEl)
          renderEl.innerHTML =
            '<pre class="text-sm text-[var(--fg-subtle)]">Diagram could not be loaded.</pre>';
      }
      return;
    }

    const cfg = buildThemeConfig();
    mermaid.initialize({
      startOnLoad: false,
      theme: cfg.theme,
      themeVariables: cfg.themeVariables,
      fontFamily: cfg.fontFamily,
      flowchart: { curve: 'basis', padding: 14, useMaxWidth: true, htmlLabels: true },
      sequence: { useMaxWidth: true, mirrorActors: false, actorMargin: 60 },
      securityLevel: 'loose',
    });

    for (const container of Array.from(containers)) {
      if (myToken !== renderToken) return;
      const id =
        container.dataset.mermaidId ?? `m-${Math.random().toString(36).slice(2)}`;
      const sourceEl = container.querySelector<HTMLElement>('.mermaid-source');
      const renderEl = container.querySelector<HTMLElement>('.mermaid-render');
      if (!sourceEl || !renderEl) continue;
      const source = sourceEl.textContent ?? '';
      try {
        const { svg } = await mermaid.render(`${id}-svg-${myToken}`, source);
        if (myToken !== renderToken) return;
        renderEl.innerHTML = svg;
      } catch (err) {
        renderEl.innerHTML =
          '<pre class="text-sm text-[var(--fg-subtle)]">Diagram failed to render.</pre>';
        console.error('Mermaid render failed', err);
      }
    }
  }

  let rerenderTimer: ReturnType<typeof setTimeout> | null = null;
  function scheduleRerender() {
    if (rerenderTimer) clearTimeout(rerenderTimer);
    rerenderTimer = setTimeout(() => renderAll(), 60);
  }

  scheduleRerender();
  document.addEventListener('astro:after-swap', scheduleRerender);

  const observer = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.attributeName === 'data-theme') {
        scheduleRerender();
        break;
      }
    }
  });
  observer.observe(document.documentElement, { attributes: true });
</script>
