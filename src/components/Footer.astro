---
const year = new Date().getFullYear();
---

<footer
  class="relative border-t border-[var(--border)] overflow-hidden"
>
  <div
    class="absolute inset-0 dot-grid opacity-30 pointer-events-none"
    aria-hidden="true"
  ></div>

  <div
    class="relative site-container py-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-xs text-[var(--fg-faint)]"
  >
    <p class="m-0 flex flex-wrap items-center gap-2.5">
      <span>&copy; {year} Ashutosh Modi</span>
      <span aria-hidden="true">&middot;</span>
      <span>Built with <a
          href="https://astro.build"
          rel="noopener"
          target="_blank"
          class="text-[var(--fg-muted)] hover:text-[var(--link)]">Astro</a></span>
      <span aria-hidden="true">&middot;</span>
      <span>Deployed to GitHub Pages</span>
    </p>

    <p class="m-0 font-mono uppercase tracking-[0.18em]">
      Made in Gurgaon, India
    </p>
  </div>
</footer>
