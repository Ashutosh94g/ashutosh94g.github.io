---
interface Props {
  variant?: 'sparse' | 'dense';
  fade?: 'top' | 'bottom' | 'radial' | 'none';
  class?: string;
}

const { variant = 'sparse', fade = 'radial', class: className = '' } = Astro.props;

const gridClass = variant === 'dense' ? 'dot-grid-dense' : 'dot-grid';
const fadeStyle =
  fade === 'top'
    ? 'mask-image: linear-gradient(to bottom, black 0%, transparent 90%); -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 90%);'
    : fade === 'bottom'
      ? 'mask-image: linear-gradient(to top, black 0%, transparent 90%); -webkit-mask-image: linear-gradient(to top, black 0%, transparent 90%);'
      : fade === 'radial'
        ? 'mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%);'
        : '';
---

<div
  class={`pointer-events-none absolute inset-0 ${gridClass} ${className}`}
  style={fadeStyle}
  aria-hidden="true"
>
</div>
