---
/**
 * Horizontal career timeline for the homepage.
 *
 * Shows the rough arc of how I got here in five visual nodes, color-coded
 * along a single gradient strip so the eye reads it left-to-right in one
 * pass. Wraps to a vertical layout on small screens.
 */

interface Stop {
  year: string;
  title: string;
  org: string;
  blurb: string;
  accent: 'indigo' | 'violet' | 'pink' | 'amber' | 'emerald';
}

const stops: Stop[] = [
  {
    year: '2018 – 2022',
    title: 'B.E. Computer Science',
    org: 'GNDU · Amritsar',
    blurb:
      'Placement Head for the cohort. Google Workshop winner. First systems classes; first Lex/Yacc.',
    accent: 'amber',
  },
  {
    year: 'Sep 2022',
    title: 'Software Developer',
    org: 'Amdocs',
    blurb:
      'Joined as a backend engineer on a Tier-1 telecom platform. Inherited a 15-year-old C / Pro*C codebase.',
    accent: 'indigo',
  },
  {
    year: 'Jun 2023',
    title: 'Compiler-driven quality',
    org: 'First framework I owned',
    blurb:
      'Lex/Yacc prototype generator + WebFOCUS auto-converter. 80% of would-be defects caught at build; 500+ scripts converted.',
    accent: 'violet',
  },
  {
    year: 'Aug 2025 – Present',
    title: 'Atlas knowledge engine',
    org: 'Owner & primary author',
    blurb:
      '5-phase pipeline over 18M lines. 1,200+ truth-grounded reasoning atoms. <$10 of premium AI per full rebuild.',
    accent: 'pink',
  },
  {
    year: 'Dec 2025 – Present',
    title: 'Tuxedo → gRPC framework',
    org: 'Three UK · Three Ireland',
    blurb:
      'Lex/Yacc transpiler + protocol shim + in-house orchestrator. Two CK Hutchison carriers in production rollout.',
    accent: 'emerald',
  },
];

const accentVar: Record<Stop['accent'], string> = {
  indigo: '#6366f1',
  violet: '#8b5cf6',
  pink: '#ec4899',
  amber: '#f59e0b',
  emerald: '#10b981',
};
---

<section
  id="journey"
  class="relative max-w-5xl mx-auto px-5 sm:px-8 py-20 border-t border-[var(--border)]"
  aria-labelledby="journey-heading"
>
  <header class="max-w-3xl mb-10">
    <p
      class="text-xs uppercase tracking-[0.2em] font-medium text-[var(--color-accent-600)] dark:text-[var(--color-accent-400)] mb-3"
    >
      The journey
    </p>
    <h2 id="journey-heading" class="display-2 mb-3">
      From first compiler to two-carrier rollout, in five steps.
    </h2>
    <p class="text-lg text-[var(--fg-muted)] leading-relaxed max-w-2xl">
      Roughly chronological. Each step still feeds the next &mdash; the
      compilers feed Atlas, Atlas feeds the rollout, and the rollout sharpens
      the next round of compilers.
    </p>
  </header>

  <!-- Visible gradient rail with stop-dots, sitting above the card row. -->
  <div class="hidden lg:block relative mb-6">
    <div
      class="absolute left-[10%] right-[10%] top-1/2 -translate-y-1/2 h-[3px] rounded-full"
      style="background: linear-gradient(90deg, #f59e0b 0%, #6366f1 25%, #8b5cf6 50%, #ec4899 75%, #10b981 100%); box-shadow: 0 0 24px rgba(99,102,241,0.3);"
      aria-hidden="true"
    />
    <ul class="relative grid grid-cols-5 list-none m-0 p-0">
      {
        stops.map((s) => (
          <li class="flex items-center justify-center py-3">
            <span
              class="relative w-5 h-5 rounded-full ring-[6px] ring-[var(--bg)]"
              style={`background: ${accentVar[s.accent]}; box-shadow: 0 0 0 2px ${accentVar[s.accent]}, 0 0 24px ${accentVar[s.accent]};`}
              aria-hidden="true"
            />
          </li>
        ))
      }
    </ul>
  </div>

  <ol class="grid gap-4 lg:grid-cols-5 list-none p-0 m-0">
    {
      stops.map((s) => (
        <li>
          <div
            class="relative bg-[var(--bg-elev)] border border-[var(--border)] rounded-2xl p-5 h-full hover:-translate-y-1 hover:border-[var(--border-strong)] transition-all overflow-hidden"
            style={`--stop-color: ${accentVar[s.accent]};`}
          >
            <span
              class="absolute top-0 left-0 right-0 h-[3px]"
              style={`background: linear-gradient(90deg, ${accentVar[s.accent]}, color-mix(in oklab, ${accentVar[s.accent]} 50%, transparent));`}
              aria-hidden="true"
            />
            <span
              class="absolute -top-12 -right-12 w-32 h-32 rounded-full opacity-20 blur-3xl pointer-events-none"
              style={`background: radial-gradient(circle, ${accentVar[s.accent]}, transparent 70%);`}
              aria-hidden="true"
            />
            <p
              class="relative text-xs uppercase tracking-[0.12em] font-semibold mb-2"
              style={`color: ${accentVar[s.accent]};`}
            >
              {s.year}
            </p>
            <h3 class="relative font-serif text-base font-semibold tracking-tight mb-1.5 leading-tight">
              {s.title}
            </h3>
            <p class="relative text-xs text-[var(--fg-subtle)] mb-2">{s.org}</p>
            <p class="relative text-sm text-[var(--fg-muted)] leading-relaxed m-0">
              {s.blurb}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
