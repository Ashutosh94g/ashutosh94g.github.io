---
interface Props {
  label?: string;
  tone?: 'live' | 'neutral';
}

const { label, tone = 'live' } = Astro.props;
const dotColor =
  tone === 'live' ? 'bg-emerald-500' : 'bg-[var(--color-accent-500)]';
---

<span
  class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--border)] bg-[var(--bg-elev)]/80 backdrop-blur text-xs font-medium text-[var(--fg-muted)]"
>
  <span class="relative inline-flex w-2 h-2">
    <span
      class={`absolute inset-0 rounded-full ${dotColor} pulse-status`}
      aria-hidden="true"
    ></span>
    <span class={`relative inline-flex w-2 h-2 rounded-full ${dotColor}`}></span>
  </span>
  <span>
    {label ? label : <slot />}
  </span>
</span>
