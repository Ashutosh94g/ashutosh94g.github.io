---
import CaseStudySigil from './CaseStudySigil.astro';

interface Metric {
  value: string;
  label: string;
}

interface Props {
  href: string;
  title: string;
  summary: string;
  role: string;
  dates: string;
  tags: string[];
  accent?: 'indigo' | 'amber' | 'emerald';
  index?: number;
  sigil?: 'tuxedo' | 'atlas' | 'compiler';
  metrics?: Metric[];
  span?: 'default' | 'wide';
  heroEyebrow?: string;
}

const {
  href,
  title,
  summary,
  role,
  dates,
  tags,
  accent = 'indigo',
  index,
  sigil,
  metrics = [],
  span = 'default',
  heroEyebrow,
} = Astro.props;

const accentClass = `accent-${accent}`;
const accentText = {
  indigo: 'text-indigo-600 dark:text-indigo-400',
  amber: 'text-amber-600 dark:text-amber-400',
  emerald: 'text-emerald-600 dark:text-emerald-400',
}[accent];

const colSpan = span === 'wide' ? 'lg:col-span-2' : 'lg:col-span-1';
---

<a
  href={href}
  class={`case-card group relative block rounded-2xl border border-[var(--border)] bg-[var(--bg-elev)] no-underline overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-[var(--border-strong)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-500)] shadow-[var(--shadow-card)] ${accentClass} ${colSpan}`}
>
  {/* Accent stripe */}
  <span
    class="absolute left-0 top-0 h-full w-[3px] accent-stripe transition-all duration-300 group-hover:w-1"
    aria-hidden="true"
  ></span>

  {/* Glow on hover */}
  <span
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style={`background: radial-gradient(80% 60% at 0% 0%, color-mix(in srgb, var(--accent-from) 12%, transparent), transparent 60%);`}
    aria-hidden="true"
  ></span>

  {/* Sigil */}
  {
    sigil && (
      <div
        class={`relative ${span === 'wide' ? 'h-44 sm:h-52' : 'h-32 sm:h-36'} overflow-hidden border-b border-[var(--border)]`}
        style="background: linear-gradient(135deg, color-mix(in oklab, var(--accent-from) 18%, var(--bg-deep)), color-mix(in oklab, var(--accent-to) 12%, var(--bg-deep)));"
      >
        <div class="absolute inset-0 dot-grid opacity-40" aria-hidden="true"></div>
        <span
          class="absolute -top-12 -right-12 w-44 h-44 rounded-full opacity-30 blur-3xl"
          style="background: radial-gradient(circle, var(--accent-from), transparent 70%);"
          aria-hidden="true"
        />
        <CaseStudySigil
          variant={sigil}
          class={`absolute inset-0 w-full h-full p-4 sm:p-6 ${accentText} transition-transform duration-500 group-hover:scale-[1.06]`}
        />
        {heroEyebrow && (
          <div class="absolute top-3 right-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--bg-elev)]/85 border border-[var(--border)] backdrop-blur text-[10px] uppercase tracking-wider font-semibold text-[var(--fg-muted)]">
            {heroEyebrow}
          </div>
        )}
      </div>
    )
  }

  <div class={`relative p-5 sm:p-6 ${span === 'wide' ? 'sm:p-8' : ''} pl-6 sm:pl-7`}>
    <div
      class="flex items-baseline justify-between gap-4 text-xs uppercase tracking-wider text-[var(--fg-subtle)] mb-3"
    >
      <span>
        {index !== undefined ? `Case ${String(index).padStart(2, '0')}` : 'Case study'}
        <span class={`ml-2 ${accentText}`}>&middot; {role}</span>
      </span>
      <span class="hidden sm:inline">{dates}</span>
    </div>

    <h3
      class={`font-serif font-semibold tracking-tight leading-tight text-[var(--fg)] mb-3 group-hover:text-[var(--link)] transition-colors ${span === 'wide' ? 'text-2xl sm:text-3xl lg:text-[2rem]' : 'text-xl sm:text-2xl'}`}
    >
      {title}
    </h3>

    <p
      class={`text-[var(--fg-muted)] leading-relaxed mb-5 ${span === 'wide' ? 'text-base sm:text-lg' : 'text-[0.95rem]'}`}
    >
      {summary}
    </p>

    {
      metrics.length > 0 && (
        <dl
          class={`grid ${span === 'wide' ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-2'} gap-x-4 gap-y-4 mb-5 not-prose`}
        >
          {metrics.slice(0, span === 'wide' ? 4 : 2).map((m) => (
            <div class="border-l-2 pl-3" style="border-color: color-mix(in oklab, var(--accent-from) 50%, transparent);">
              <dt class="text-[10px] uppercase tracking-[0.12em] font-semibold text-[var(--fg-subtle)] mb-0.5">
                {m.label}
              </dt>
              <dd
                class={`font-mono font-semibold tracking-tight m-0 leading-none ${span === 'wide' ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl'}`}
                style={`background: linear-gradient(180deg, var(--accent-from), var(--accent-to)); -webkit-background-clip: text; background-clip: text; color: transparent;`}
              >
                {m.value}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="flex flex-wrap items-center gap-2">
      {
        tags.slice(0, 4).map((tag) => (
          <span class="inline-flex text-xs px-2 py-0.5 rounded-full border border-[var(--border)] text-[var(--fg-subtle)] bg-[var(--bg)]">
            {tag}
          </span>
        ))
      }
      <span
        class={`ml-auto text-sm font-medium transition-all duration-200 ${accentText} group-hover:translate-x-0.5`}
        aria-hidden="true"
      >
        Read &rarr;
      </span>
    </div>
  </div>
</a>

<style>
  .case-card {
    --accent-shadow:
      0 22px 50px -22px color-mix(in oklab, var(--accent-from) 55%, transparent),
      0 8px 20px -10px color-mix(in oklab, var(--accent-from) 35%, transparent);
  }
  .case-card:hover { box-shadow: var(--accent-shadow); }
</style>
