---
/**
 * Nav — sticky, glass-blur on scroll. Dark only.
 *
 * The data-scrolled state is toggled by scripts/nav-scroll.ts (in
 * BaseLayout). Pure CSS handles the actual blur + border transition.
 */

const links = [
  { href: "/#about", label: "About" },
  { href: "/#principles", label: "How I Work" },
  { href: "/#projects", label: "Work" },
  { href: "/#experience", label: "Experience" },
  { href: "/#contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isHome = path === "/" || path === "";
---

<header class="nav-shell">
  <nav
    class="site-container h-16 flex items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a
      href="/"
      class="group inline-flex items-center gap-2.5 no-underline font-semibold tracking-tight text-[var(--fg)] hover:text-[var(--link)] transition-colors"
      aria-current={isHome ? "page" : undefined}
    >
      <span
        class="inline-flex items-center justify-center w-8 h-8 rounded-md text-white font-serif text-sm font-bold leading-none shadow-[0_4px_12px_-4px_rgba(139,92,246,0.6)]"
        style="background: linear-gradient(135deg, #6366f1, #8b5cf6 50%, #ec4899);"
        aria-hidden="true"
      >
        am
      </span>
      <span class="hidden sm:inline text-[0.95rem]">Ashutosh Modi</span>
    </a>

    <ul class="hidden sm:flex items-center gap-1 list-none m-0 p-0">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="px-3 py-1.5 rounded-md text-sm no-underline text-[var(--fg-muted)] hover:text-[var(--fg)] hover:bg-[rgba(255,255,255,0.03)] transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener"
        class="btn-cta btn-cta-secondary text-sm"
        style="padding: 0.5rem 0.9rem; border-radius: 0.6rem; font-size: 0.85rem;"
      >
        <svg
          aria-hidden="true"
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3v12" />
          <path d="m6 9 6 6 6-6" />
          <path d="M5 21h14" />
        </svg>
        Resume
      </a>
    </div>
  </nav>
</header>
