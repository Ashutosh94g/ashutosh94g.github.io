---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#case-studies', label: 'Case studies' },
  { href: '/writing/', label: 'Writing' },
  { href: '/resume.pdf', label: 'Resume', external: true },
];

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 backdrop-blur-md bg-[var(--bg)]/80 border-b border-[var(--border)]"
>
  <nav
    class="max-w-5xl mx-auto px-5 sm:px-8 h-14 flex items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a
      href="/"
      class="font-semibold tracking-tight no-underline text-[var(--fg)] hover:text-[var(--link)] transition-colors"
      aria-current={path === '/' ? 'page' : undefined}
    >
      Ashutosh Modi
    </a>

    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="hidden sm:flex items-center gap-1 list-none m-0 p-0">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="px-3 py-1.5 rounded text-sm text-[var(--fg-muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-elev)] no-underline transition-colors"
                {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
