---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#case-studies', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/now/', label: 'Now' },
  { href: '/writing/', label: 'Writing' },
  { href: '/resume.pdf', label: 'Resume', external: true },
];

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 backdrop-blur-md bg-[var(--bg)]/75 border-b border-[var(--border)]"
>
  <nav
    class="max-w-6xl mx-auto px-5 sm:px-8 h-14 flex items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a
      href="/"
      class="font-semibold tracking-tight no-underline text-[var(--fg)] hover:text-[var(--link)] transition-colors flex items-center gap-2"
      aria-current={path === '/' ? 'page' : undefined}
    >
      <span
        class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-gradient-to-br from-[var(--color-accent-500)] to-[var(--color-accent-700)] text-white font-serif text-sm font-bold leading-none"
        aria-hidden="true"
      >
        am
      </span>
      <span class="hidden sm:inline">Ashutosh Modi</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-0.5 list-none m-0 p-0">
        {
          links.map((link) => {
            const isActive =
              link.href === path ||
              (link.href !== '/' &&
                link.href.endsWith('/') &&
                path.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class={`px-2.5 sm:px-3 py-1.5 rounded text-sm no-underline transition-colors ${
                    isActive
                      ? 'text-[var(--fg)] font-medium'
                      : 'text-[var(--fg-muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-elev)]'
                  }`}
                  {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
