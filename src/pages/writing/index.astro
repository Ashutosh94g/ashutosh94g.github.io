---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title="Writing"
  description="Notes on backend systems, parser-driven tooling, and AI development workflows."
>
  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-12 pb-16">
    <header class="mb-8">
      <h1
        class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight leading-tight mb-4"
      >
        Writing
      </h1>
      <p class="text-[var(--fg-muted)] leading-relaxed max-w-2xl">
        Short essays on the work — backend systems, parser-driven tooling, AI
        development workflows. Posts go up here as they're worth writing.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <div class="rounded-lg border border-dashed border-[var(--border-strong)] bg-[var(--bg-elev)] p-8 sm:p-10">
          <p class="text-[var(--fg-muted)] m-0 leading-relaxed">
            No posts yet. The case studies on the home page are the long-form work for
            now;{' '}
            <a href="/#case-studies">start there</a>.
          </p>
          <p class="text-sm text-[var(--fg-subtle)] mt-3 m-0">
            This page is structurally ready &mdash; new MDX posts dropped into{' '}
            <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--bg)] border border-[var(--border)]">
              src/content/writing/
            </code>{' '}
            will appear here in publication order.
          </p>
        </div>
      ) : (
        <ul class="grid gap-4 list-none m-0 p-0">
          {posts.map((post) => (
            <li>
              <a
                href={`/writing/${post.id}/`}
                class="block p-5 rounded-lg border border-[var(--border)] bg-[var(--bg-elev)] no-underline hover:border-[var(--border-strong)] transition-colors"
              >
                <div class="flex items-baseline justify-between gap-4 text-xs uppercase tracking-wider text-[var(--fg-subtle)] mb-2">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFormatter.format(post.data.pubDate)}
                  </time>
                  {post.data.tags.length > 0 && (
                    <span>{post.data.tags.slice(0, 2).join(' · ')}</span>
                  )}
                </div>
                <h2 class="font-serif text-xl font-semibold tracking-tight leading-tight text-[var(--fg)] mb-2">
                  {post.data.title}
                </h2>
                <p class="text-[var(--fg-muted)] m-0 leading-relaxed">
                  {post.data.summary}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
