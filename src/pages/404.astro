---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section
    class="relative max-w-3xl mx-auto px-5 sm:px-8 pt-24 pb-32 sm:pt-36 sm:pb-40 text-center overflow-hidden"
  >
    <div
      class="absolute inset-0 opacity-30 pointer-events-none"
      style="background:
        radial-gradient(600px 300px at 50% 0%, rgba(139,92,246,0.18), transparent 60%),
        radial-gradient(500px 260px at 50% 100%, rgba(236,72,153,0.10), transparent 70%);"
      aria-hidden="true"
    ></div>

    <div class="relative">
      <p class="eyebrow mb-5">Error 404</p>
      <h1 class="display-1 mb-6 leading-[1.02]">
        That page <span class="gradient-text">isn&rsquo;t here.</span>
      </h1>
      <p class="text-lg text-[var(--fg-muted)] leading-relaxed mb-10 max-w-xl mx-auto">
        Either the URL drifted or the page never existed. The case studies and
        the resume are the durable links &mdash; either should land you
        somewhere useful.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-cta btn-cta-primary magnetic">Home</a>
        <a href="/#projects" class="btn-cta btn-cta-secondary magnetic">
          Case studies
        </a>
        <a href="/resume.pdf" class="btn-cta btn-cta-secondary magnetic" target="_blank" rel="noopener">
          Resume PDF
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
