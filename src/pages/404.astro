---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section
    class="max-w-2xl mx-auto px-5 sm:px-8 pt-20 pb-24 sm:pt-28 sm:pb-32 text-center"
  >
    <p class="text-sm text-[var(--fg-subtle)] uppercase tracking-wider font-medium mb-4">
      404
    </p>
    <h1
      class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1] mb-5"
    >
      That page isn't here.
    </h1>
    <p class="text-lg text-[var(--fg-muted)] leading-relaxed mb-8">
      Either the URL drifted or the page never existed. The case studies and the
      resume are the durable links &mdash; either should land you somewhere useful.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[var(--color-accent-600)] text-white no-underline font-medium hover:bg-[var(--color-accent-700)] transition-colors"
      >
        Home
      </a>
      <a
        href="/#case-studies"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-[var(--border-strong)] text-[var(--fg)] no-underline font-medium hover:bg-[var(--bg-elev)] transition-colors"
      >
        Case studies
      </a>
      <a
        href="/resume.pdf"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-[var(--border-strong)] text-[var(--fg)] no-underline font-medium hover:bg-[var(--bg-elev)] transition-colors"
      >
        Resume (PDF)
      </a>
    </div>
  </section>
</BaseLayout>
