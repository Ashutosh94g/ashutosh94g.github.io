---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusPill from '../components/StatusPill.astro';
import DotGrid from '../components/DotGrid.astro';

const lastUpdated = 'Apr 26, 2026';

const focus = [
  {
    label: 'Shipping',
    title: 'Tuxedo \u2192 gRPC framework rolling out across two carriers',
    body: "The framework is in production on the POC service and in fleet rollout across CK Hutchison's Three UK and Three Ireland. Most of my week is spent unblocking carrier-specific quirks, hardening the orchestrator, and reviewing the rolled-out services as they migrate.",
  },
  {
    label: 'Building',
    title: "Atlas's CR \u2192 implementation pipeline (phase 5)",
    body: "Phases 1\u20134 are stable. Phase 5 \u2014 turning a change request into HLD, LLD, impact analysis, and an autogenerated test matrix \u2014 is the current focus. 6 of 8 in the test matrix are autogenerated end-to-end; the remaining two are the trickiest cross-process billing flows.",
  },
  {
    label: 'Teaching',
    title: 'Internal AI workflows for the team',
    body: "Running monthly walkthroughs of the rule + skill catalog, the layered context model, and the Atlas query patterns. Every session adds three or four new entries to the catalog from the questions that come up.",
  },
  {
    label: 'Reading',
    title: 'A short list this month',
    body: "\u201CDesigning Data-Intensive Applications\u201D (re-reading the consensus chapters); recent posts from the Cursor / Claude / Cognition AI engineering blogs; old Tuxedo internals docs from when the carrier first deployed it. The intersection is more useful than any one of them.",
  },
  {
    label: 'Writing',
    title: 'A few drafts in flight',
    body: "Notes on the layered-context model that powers Atlas; a short essay on why parser-driven tools beat heuristic tools every time; a sketch on \u201Chonest framing for a framework you didn't single-handedly migrate.\u201D Some of these will land in the Writing section as they're worth shipping.",
  },
  {
    label: 'Thinking about',
    title: 'What\u2019s next',
    body: "Platform & systems work is the lane; AI infrastructure is the adjacent lane. I\u2019m increasingly interested in roles where the two overlap \u2014 knowledge engineering for real production codebases. Open to conversations.",
  },
];
---

<BaseLayout
  title="Now"
  description="A short snapshot of what I'm focused on right now \u2014 borrowed from the /now convention. Updated when focus shifts."
>
  <section class="relative overflow-hidden border-b border-[var(--border)]">
    <div class="absolute inset-0 hero-glow pointer-events-none" aria-hidden="true"></div>
    <DotGrid variant="sparse" fade="bottom" />

    <div class="relative max-w-3xl mx-auto px-5 sm:px-8 pt-12 pb-12 sm:pt-16">
      <div class="fade-up">
        <StatusPill>
          Updated {lastUpdated}
        </StatusPill>
      </div>
      <h1
        class="fade-up font-serif text-4xl sm:text-5xl lg:text-[3.5rem] font-semibold tracking-tight leading-[1.04] mt-5 mb-5"
      >
        What I'm working on <span class="gradient-text">right now.</span>
      </h1>
      <p
        class="fade-up-delay-1 text-lg sm:text-xl text-[var(--fg-muted)] leading-relaxed max-w-2xl"
      >
        A short, refreshed snapshot of where my attention is. Borrowed from the
        <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now</a>
        convention. If you're reading this far enough out from <em>{lastUpdated}</em>,
        the page is probably stale.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-5 sm:px-8 py-14 sm:py-16">
    <ul class="grid gap-6 list-none m-0 p-0">
      {
        focus.map((item) => (
          <li class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elev)] p-5 sm:p-6 shadow-[var(--shadow-card)]">
            <p class="text-xs uppercase tracking-[0.2em] font-medium text-[var(--color-accent-600)] dark:text-[var(--color-accent-400)] mb-2">
              {item.label}
            </p>
            <h2 class="font-serif text-xl sm:text-2xl font-semibold tracking-tight leading-snug text-[var(--fg)] m-0 mb-2">
              {item.title}
            </h2>
            <p class="text-[var(--fg-muted)] leading-relaxed m-0">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <hr class="my-12 border-[var(--border)]" />

    <p class="text-sm text-[var(--fg-subtle)] leading-relaxed">
      Want the bigger picture? Read <a href="/about/">about me</a> or pick a
      <a href="/#case-studies">case study</a>. Want to talk?
      <a href="mailto:ashutosh94g@gmail.com">Email</a> is best.
    </p>
  </section>
</BaseLayout>
