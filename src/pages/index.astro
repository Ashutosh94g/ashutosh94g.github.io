---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import Hero from "../components/Hero.astro";
import About from "../components/sections/About.astro";
import HowIWork from "../components/sections/HowIWork.astro";
import Projects from "../components/sections/Projects.astro";
import Skills from "../components/sections/Skills.astro";
import Experience from "../components/sections/Experience.astro";
import Contact from "../components/sections/Contact.astro";

const SITE_URL = "https://ashutosh94g.github.io/";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}#person`,
  name: "Ashutosh Modi",
  givenName: "Ashutosh",
  familyName: "Modi",
  url: SITE_URL,
  image: `${SITE_URL}og/default.png`,
  email: "mailto:ashutosh94g@gmail.com",
  jobTitle: "Software Developer",
  worksFor: {
    "@type": "Organization",
    name: "Amdocs",
    url: "https://www.amdocs.com/",
  },
  homeLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Gurgaon",
      addressRegion: "Haryana",
      addressCountry: "IN",
    },
  },
  sameAs: [
    "https://github.com/ashutosh94g",
    "https://www.linkedin.com/in/ashutosh94g/",
  ],
  knowsAbout: [
    "gRPC",
    "Protocol Buffers",
    "Backend Engineering",
    "Platform Engineering",
    "Legacy Modernization",
    "Distributed Systems",
    "Service Discovery",
    "HAProxy",
    "HashiCorp Consul",
    "HashiCorp Nomad",
    "Apache Kafka",
    "Compilers",
    "Lex/Yacc",
    "C",
    "C++",
    "Python",
    "Pandas",
    "AI Development Platforms",
    "Cursor",
    "Knowledge Engineering",
    "Telecom Backend Systems",
    "Oracle Tuxedo",
    "TIBCO WebFOCUS",
  ],
  description:
    "Software developer at Amdocs focused on backend platforms, legacy modernization, parser-driven automation, and practical AI developer workflows.",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}#website`,
  name: "Ashutosh Modi",
  url: SITE_URL,
  author: { "@id": `${SITE_URL}#person` },
  inLanguage: "en",
};
---

<BaseLayout>
  <Fragment slot="head">
    <JsonLd schema={personSchema} />
    <JsonLd schema={websiteSchema} />
    <link rel="preload" as="image" href="/og/default.png" />
  </Fragment>

  <Hero />
  <About />
  <HowIWork />
  <Projects />
  <Skills />
  <Experience />
  <Contact />
</BaseLayout>
