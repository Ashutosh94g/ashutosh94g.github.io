---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import CaseStudyTOC from '../components/CaseStudyTOC.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Metric {
  value: string;
  label: string;
}

interface Props {
  title: string;
  summary: string;
  role: string;
  dates: string;
  tags: string[];
  accent?: 'indigo' | 'amber' | 'emerald';
  metrics?: Metric[];
  heroEyebrow?: string;
  headings?: MarkdownHeading[];
  ogImage?: string;
}

const {
  title,
  summary,
  role,
  dates,
  tags,
  accent = 'indigo',
  metrics = [],
  heroEyebrow,
  headings = [],
  ogImage,
} = Astro.props;

const SITE_URL = 'https://ashutosh94g.github.io/';
const articleUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const ogPath = ogImage ?? '/og/default.png';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: summary,
  url: articleUrl,
  image: new URL(ogPath, SITE_URL).toString(),
  author: {
    '@type': 'Person',
    name: 'Ashutosh Modi',
    url: SITE_URL,
  },
  keywords: tags.join(', '),
  inLanguage: 'en-US',
};

const accentBg = {
  indigo: 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/20',
  amber: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/20',
  emerald:
    'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20',
}[accent];

const accentClass = `accent-${accent}`;
---

<BaseLayout
  title={title}
  description={summary}
  pageType="article"
  ogImage={ogPath}
>
  <Fragment slot="head">
    <JsonLd schema={articleSchema} />
  </Fragment>

  <ReadingProgress />

  <article class={`case-article ${accentClass}`}>
    <div class="relative overflow-hidden border-b border-[var(--border)]">
      <div
        class="absolute inset-0 hero-glow pointer-events-none"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 dot-grid opacity-60 pointer-events-none"
        style="mask-image: linear-gradient(to bottom, black 0%, transparent 90%); -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 90%);"
        aria-hidden="true"
      ></div>

      <header class="relative max-w-3xl mx-auto px-5 sm:px-8 pt-12 pb-12 sm:pt-16 fade-up">
        <p
          class="text-xs sm:text-sm uppercase tracking-[0.18em] font-medium text-[var(--fg-subtle)] mb-4 flex items-center gap-2 flex-wrap"
        >
          <a href="/#projects" class="no-underline hover:underline text-[var(--fg-muted)]">
            Case studies
          </a>
          <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>
          <span>{dates}</span>
          {heroEyebrow && (
            <>
              <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>
              <span class="text-[var(--color-accent-600)] dark:text-[var(--color-accent-400)] normal-case tracking-normal">
                {heroEyebrow}
              </span>
            </>
          )}
        </p>

        <h1
          class="font-serif text-4xl sm:text-5xl lg:text-[3.5rem] font-semibold tracking-tight leading-[1.04] mb-5"
        >
          {title}
        </h1>

        <p class="text-lg sm:text-xl text-[var(--fg-muted)] leading-relaxed mb-6 max-w-2xl">
          {summary}
        </p>

        <div class="flex flex-wrap items-center gap-2 mb-7">
          <span
            class={`inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-full border ${accentBg}`}
          >
            {role}
          </span>
          {
            tags.map((tag) => (
              <span class="inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-full border border-[var(--border)] text-[var(--fg-muted)] bg-[var(--bg-elev)]">
                {tag}
              </span>
            ))
          }
        </div>

        {
          metrics.length > 0 && (
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 not-prose pt-6 border-t border-[var(--border)]">
              {metrics.map((m) => (
                <div class="border-l border-[var(--border)] pl-3">
                  <dd class="font-serif font-semibold text-2xl tracking-tight text-[var(--fg)] m-0">
                    {m.value}
                  </dd>
                  <dt class="text-[11px] uppercase tracking-wider font-medium text-[var(--fg-subtle)] mt-1">
                    {m.label}
                  </dt>
                </div>
              ))}
            </dl>
          )
        }
      </header>
    </div>

    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 pt-12 pb-16">
      <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_220px] xl:gap-12">
        <div class="prose max-w-3xl mx-auto xl:mx-0 xl:max-w-3xl xl:justify-self-end xl:w-full">
          <slot />

          <hr class="my-12 border-[var(--border)]" />

          <nav
            class="not-prose flex flex-col sm:flex-row sm:justify-between gap-3 text-sm"
            aria-label="Case study navigation"
          >
            <a
              href="/#projects"
              class="text-[var(--fg-muted)] hover:text-[var(--link)]"
            >
              &larr; All case studies
            </a>
            <a href="/" class="text-[var(--fg-muted)] hover:text-[var(--link)]">
              Back home &rarr;
            </a>
          </nav>
        </div>

        <aside
          class="hidden xl:block sticky top-20 self-start max-h-[calc(100vh-6rem)] overflow-y-auto"
        >
          <CaseStudyTOC headings={headings} />
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
